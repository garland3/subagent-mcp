#!/usr/bin/env python3
"""Fake opencode CLI for subagent-mcp tests."""

import json
import os
import sys
import time


def main() -> None:
    log_path = os.environ.get("SUBAGENT_TEST_LOG")

    # Handle `opencode session list` for post-launch id capture (Phase 0.1).
    # The real opencode enumerates sessions here; the fake returns an empty
    # list so the capture finds no match and records "capture_failed" — the
    # visible failure mode the design calls out. Returning quickly (no sleep)
    # keeps the test fast.
    if len(sys.argv) >= 3 and sys.argv[1] == "session" and sys.argv[2] == "list":
        print("[]")
        return

    # Parse just enough to extract --prompt value.
    prompt: str | None = None
    i = 1
    while i < len(sys.argv):
        arg = sys.argv[i]
        if arg in ("--prompt",):
            i += 1
            if i < len(sys.argv):
                prompt = sys.argv[i]
        elif arg.startswith("--prompt="):
            prompt = arg.split("=", 1)[1]
        i += 1

    out = {"cli": "opencode", "argv": sys.argv[1:], "prompt": prompt}
    if log_path:
        with open(log_path, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(out, ensure_ascii=False) + "\n")
    else:
        print(json.dumps(out, ensure_ascii=False))

    time.sleep(120)


if __name__ == "__main__":
    main()
