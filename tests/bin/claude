#!/usr/bin/env python3
"""Fake claude CLI for subagent-mcp tests.

Logs argv and the positional prompt to $SUBAGENT_TEST_LOG, then sleeps so tests
have time to inspect the tmux pane.
"""

import json
import os
import signal
import sys
import termios
import tty
import time


def main() -> None:
    log_path = os.environ.get("SUBAGENT_TEST_LOG")
    # Find the prompt: the first non-option argument.
    # Supports --model x, --agent y, --dangerously-skip-permissions, --session-id uuid.
    prompt: str | None = None
    session_id: str | None = None
    i = 1
    while i < len(sys.argv):
        arg = sys.argv[i]
        if arg in ("--model", "--agent", "--session-id"):
            if arg == "--session-id" and i + 1 < len(sys.argv):
                session_id = sys.argv[i + 1]
            i += 2
            continue
        if arg.startswith("--session-id="):
            session_id = arg.split("=", 1)[1]
            i += 1
            continue
        if arg == "--dangerously-skip-permissions":
            i += 1
            continue
        prompt = arg
        # Keep scanning in case more trailing args; use the last one.
        i += 1

    out = {"cli": "claude", "argv": sys.argv[1:], "prompt": prompt, "session_id": session_id}
    if log_path:
        with open(log_path, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(out, ensure_ascii=False) + "\n")
    else:
        print(json.dumps(out, ensure_ascii=False))

    # A prompt of "exit-now" reproduces the normal end state: the CLI
    # returns while run.sh goes on to exec an interactive shell, so the
    # pane outlives the agent.
    if prompt and prompt.strip().startswith("exit-now"):
        return

    # Some tests need a CLI that shrugs off Ctrl-C the way a real TUI does, so
    # stop_subagent's escalation ladder has something to escalate against.
    # Raw mode is how claude/opencode really do it: the terminal stops turning
    # ^C into SIGINT and hands it over as a plain 0x03 byte the app decides
    # what to do with, which is why one Ctrl-C does not end them.
    # A marker file, not an env var: tmux panes inherit the tmux *server's*
    # environment, which the test process cannot amend after the server is up.
    if os.path.exists(os.path.join(os.getcwd(), ".ignore-sigint")):
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        try:
            tty.setraw(sys.stdin.fileno())
        except (termios.error, ValueError, OSError):
            pass

    # Sleep until killed or a very long timeout.
    time.sleep(120)


if __name__ == "__main__":
    main()
